# Copy this file to .env.local and fill in your values.
#
# The folder to scan is chosen IN THE APP (Home → Choose folder), not here —
# so there is nothing to configure for local file access. Your files never
# leave this machine.
#
# Azure OpenAI — used server-side to extract drawing titles + tags. Only a small
# snippet of each PDF's title block (text, or a cropped image of the bottom-right
# corner) is sent — never the whole file.
# (No NEXT_PUBLIC_ prefix: these must never reach the browser.)
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_API_KEY=YOUR-AZURE-OPENAI-KEY
